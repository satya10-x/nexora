{
  "name": "sentinelqa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SentinelQA — autonomous UI testing by Nexora (client + server + demo app)",
  "scripts": {
    "dev": "concurrently -n server,demo,client -c blue,magenta,green \"npm:dev:server\" \"npm:dev:demo\" \"npm:dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:demo": "npm --prefix demo-app run dev",
    "build": "npm --prefix client run build",
    "typecheck": "npm --prefix client run typecheck",
    "preview": "npm --prefix client run preview",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install && npm --prefix demo-app install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
